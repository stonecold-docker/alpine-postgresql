#!/bin/sh

set -e

if [ -e /.init ]; then
	exit
fi

touch /.init

#mkdir -p /conf.d/phppgadmin

POSTGRESQL_REPO=${POSTGRESQL_REPO:-/repo}

#if [ ! -s /conf.d/phppgadmin/config.inc.php ]; then
#	sed -e "s/\(\$conf\['extra_login_security'\] = \).*$/\1 false;/g" /app/phppgadmin/conf/config.inc.php-dist > /conf.d/phppgadmin/config.inc.php
#
#	if [ "$(realpath /app/phppgadmin/conf/config.inc.php)" != "/conf.d/phppgadmin/config.inc.php" ]; then
#		ln -sf /conf.d/phppgadmin/config.inc.php /app/phppgadmin/conf/config.inc.php
#	fi
#fi


chown -R postgres:postgres ${POSTGRESQL_REPO}

if [ ! -e ${POSTGRESQL_REPO}/base ]; then
	rm -rf ${POSTGRESQL_REPO}/*

	cat << 'EOF' > /usr/local/bin/locale
#!/bin/sh
echo > /dev/null
EOF
	chmod 755 /usr/local/bin/locale
	su-exec postgres pg_ctl initdb -D ${POSTGRESQL_REPO}
	su-exec postgres postgres -D ${POSTGRESQL_REPO} &
	sleep 1
	su-exec postgres psql -c "ALTER USER postgres PASSWORD 'postgres';"
	su-exec postgres pg_ctl stop -D ${POSTGRESQL_REPO}
	rm -rf /usr/local/bin/locale
fi

